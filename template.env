# Project configuration for developing zrb itself.
# ./project.sh copies this file to .env on first bootstrap and sources it in
# every shell it spawns afterwards.

# Colon-separated Python scripts zrb runs on startup (in addition to any
# auto-discovered `zrb_init.py`) to register task definitions.
export ZRB_INIT_SCRIPTS="zrb_init.py"

# Python modules zrb imports on startup, same syntax as ZRB_INIT_SCRIPTS.
export ZRB_INIT_MODULES=""
