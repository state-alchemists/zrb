{
  "_comment": [
    "Copy this into ~/.zrb/hooks.json, MERGING with any existing hooks block.",
    "Replace <ZRB_REPO> with the absolute path of your zrb checkout, e.g.",
    "  /home/you/zrb            (Linux)",
    "  /Users/you/zrb           (macOS)",
    "  /home/you/zrb            (WSL)",
    "The trailing '|| exit 0' is not optional -- see README, 'Why this is safe'.",
    "'async': true is also required, not cosmetic: it is what makes a Stop hook",
    "structurally unable to block and re-run your turn."
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <ZRB_REPO>/examples/voice-interaction/hook_speak.py || exit 0",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <ZRB_REPO>/examples/voice-interaction/hook_speak.py || exit 0",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 <ZRB_REPO>/examples/voice-interaction/hook_speak.py || exit 0",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
