{
  "_comment": [
    "Start zrb from examples/voice-interaction: the command path is relative to the session's working directory.",
    "async and '|| exit 0' keep a failing hook from blocking or re-running the turn."
  ],
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hook_speak.py || exit 0",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hook_speak.py || exit 0",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hook_speak.py || exit 0",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
